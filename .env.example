# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real values.
#
# These are read by the CDK stacks (lib/*.js) and fetch-s3-data.js.
# You can alternatively pass them as CDK context, e.g.
#   cdk deploy -c alarmEmail=you@example.com -c urlsBucketName=my-bucket

# --- Monitoring stack (WebCrawlerStack) ---
# Email address that receives CloudWatch alarm notifications via SNS.
ALARM_EMAIL=you@example.com

# S3 bucket that holds the monitored-URL list (urls.json).
URLS_BUCKET_NAME=my-monitoring-urls-bucket
# Object key of the URL list within that bucket (optional, defaults to urls.json).
URLS_OBJECT_KEY=urls.json

# --- CI/CD pipeline stack (WebCrawlerPipelineStack) ---
# GitHub repository the pipeline pulls source from.
GITHUB_OWNER=your-github-username
GITHUB_REPO=Cloud-Monitoring-App
GITHUB_BRANCH=main
# Name of the AWS Secrets Manager secret holding the GitHub OAuth token.
GITHUB_TOKEN_SECRET=github-token

# Account/region are taken from your AWS CLI profile / CDK environment
# (CDK_DEFAULT_ACCOUNT / CDK_DEFAULT_REGION) — no need to set them here.
